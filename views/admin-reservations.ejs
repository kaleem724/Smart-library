<%- include("partials/head") %><h1>Manage Reservations</h1><form class="bar" method="get"><input name="q" value="<%= q %>" placeholder="Search book or student"><select name="status"><option value="">All statuses</option>
<% ['Pending','Approved','Rejected','Cancelled','Returned'].forEach(s=>{ %><option <%= s===status?'selected':'' %>><%= s %></option><% }) %></select><button>Filter</button></form>
<div class="wrap"><table><tr><th>#</th><th>Student</th><th>Book</th><th>Date</th><th>Status</th><th>Actions</th></tr>
<% rows.forEach(r=>{ %><tr><td><%= r.id %></td><td><%= r.name %><br><small><%= r.email %></small></td><td><%= r.title %></td><td><%= new Date(r.reserved_at).toLocaleString() %></td><td><span class="badge <%= r.status %>"><%= r.status %></span></td><td class="acts">
<% if(r.status==='Pending'){ %><form method="post" action="/admin/reservations/<%= r.id %>/approve"><button class="green sm">Approve</button></form><form method="post" action="/admin/reservations/<%= r.id %>/reject" data-confirm="Reject?"><button class="red sm">Reject</button></form><% } %>
<% if(r.status==='Approved'){ %><form method="post" action="/admin/reservations/<%= r.id %>/return"><button class="sm">Mark returned</button></form><form method="post" action="/admin/reservations/<%= r.id %>/cancel" data-confirm="Cancel?"><button class="red sm">Cancel</button></form><% } %></td></tr><% }) %></table></div><%- include("partials/foot") %>
