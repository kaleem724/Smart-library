<% 
// बैकएंड से वेरिएबल न मिलने पर पेज को क्रैश होने से बचाने के लिए सेफ़्टी कोड
var q = typeof q !== 'undefined' ? q : ''; 
var cat = typeof cat !== 'undefined' ? cat : '';
var cats = typeof cats !== 'undefined' ? cats : [];
%>

<%- include("partials/head") %>

<h1>Book Catalogue</h1>

<form class="bar" method="get">
  <input name="q" value="<%= q %>" placeholder="Search title, author or category">
  <select name="category">
    <option value="">All categories</option>
    <% cats.forEach(c => { %>
      <option <%= c.category === cat ? 'selected' : '' %>><%= c.category %></option>
    <% }) %>
  </select>
  <button><i class="fa fa-search"></i> Search</button>
</form>

<% if(!books.length){ %>
  <p>No books found.</p>
<% } %>

<div class="grid">
  <% books.forEach(b => { %>
    <%- include("partials/card", { b: b }) %> 
  <% }) %>
</div>

<%- include("partials/foot") %>
